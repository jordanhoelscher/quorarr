# Quorarr configuration — copy to quorarr.env, fill in, and `chmod 600` it.
#
# Every value below is a placeholder. Nothing here is a real credential.
# docs/setup-guide.md walks through where each one comes from.
#
# Quorarr refuses to start if a REQUIRED variable is missing or if a quality
# profile id is 0 — a half-configured deploy fails loudly instead of filing
# requests against whatever profile the arr happens to pick.


# ─── Core ────────────────────────────────────────────────────────────────────

# REQUIRED, minimum 32 characters. Signs the session, PIN-handshake, and guest
# cookies. A shorter one is a startup error: a guessable signing key is a
# forgeable owner session.
#   openssl rand -hex 32
# Rotating this signs EVERYONE out, you included. It is not how you revoke one
# person — use the owner's user list for that.
SESSION_SECRET=replace-me-with-64-hex-characters

# REQUIRED, no default. The public HTTPS origin your users reach the app on.
# Plex OAuth redirects to <BASE_URL>/auth/callback: a wrong value does not
# error, it forwards a user's freshly minted auth token to somebody else's
# host. No trailing slash.
BASE_URL=https://media.example.com


# ─── Plex ────────────────────────────────────────────────────────────────────

# REQUIRED. A stable UUID identifying this app to plex.tv. Generate once:
#   python3 -c "import uuid; print(uuid.uuid4())"
# Keep it forever — changing it invalidates in-flight logins and creates a new
# entry in each user's Plex authorized-devices list.
PLEX_CLIENT_ID=00000000-0000-0000-0000-000000000000

# REQUIRED. Your server's machineIdentifier. This is the login gate: an account
# with no share on THIS machine id cannot sign in.
#   curl -s "http://plex.local:32400/identity" | grep -o 'machineIdentifier="[^"]*"'
PLEX_SERVER_MACHINE_ID=0000000000000000000000000000000000000000

# REQUIRED. Your numeric plex.tv account id — the account that gets the owner
# role (approvals, deletions, 4K, user management).
#   curl -s -H "Accept: application/json" -H "X-Plex-Token: YOUR_TOKEN" \
#     https://plex.tv/api/v2/user | python3 -c "import json,sys;print(json.load(sys.stdin)['id'])"
PLEX_OWNER_ACCOUNT_ID=0

# Optional, but required for the access-request flow and the hourly share
# reconcile: your own X-Plex-Token. Approving an access request calls plex.tv
# to share every library section with the requester; without this token that
# approval answers 502.
# This is a full-power Plex credential — keep this file at mode 600.
PLEX_OWNER_TOKEN=


# ─── Radarr / Sonarr / Jellyseerr ────────────────────────────────────────────

# Container-internal URLs. Defaults shown; override if your hostnames differ.
RADARR_URL=http://radarr:7878
SONARR_URL=http://sonarr:8989
JELLYSEERR_URL=http://jellyseerr:5055

# REQUIRED. Settings → General → API Key in each app.
RADARR_API_KEY=replace-me
SONARR_API_KEY=replace-me
JELLYSEERR_API_KEY=replace-me


# ─── Quality profile ids ─────────────────────────────────────────────────────
#
# Quorarr never lets a client send a profile id. It maps a fixed vocabulary
# ("720p", "1080p", "4K") onto the ids below, so every request lands in a lane
# you audited. Find your ids:
#
#   curl -s -H "X-Api-Key: $RADARR_API_KEY" \
#     http://radarr:7878/api/v3/qualityprofile | jq '.[] | {id, name}'
#
#   curl -s -H "X-Api-Key: $SONARR_API_KEY" \
#     http://sonarr:8989/api/v3/qualityprofile | jq '.[] | {id, name}'
#
# (No jq? Append: | python3 -m json.tool  — and read off "id" and "name".)
# From outside the Docker network use the published host:port instead.

# REQUIRED, must be > 0. The 1080p lane — the self-serve default.
RADARR_PROFILE_HD_ID=0
SONARR_PROFILE_HD_ID=0

# REQUIRED, must be > 0. The 4K lane — owner-approved for everyone but you.
RADARR_PROFILE_4K_ID=0
SONARR_PROFILE_4K_ID=0

# Optional. Sonarr's 720p profile: the "space-saver" lane members can pick for
# sitcoms and background TV. Leave at 0 and the 720p option is simply not
# available — a request for it errors rather than silently costing you the
# 1080p size difference. TV only; there is no 720p lane for movies.
SONARR_PROFILE_720_ID=0


# ─── Notifications ───────────────────────────────────────────────────────────

# Optional. Web Push (VAPID) keypair. Empty disables push entirely: the app
# still works, but owner-facing events go to Discord only and members get no
# notifications at all.
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# REQUIRED IF you set either VAPID key above (a startup error otherwise). Sent
# to Apple/Google/Mozilla as the VAPID "sub" claim: a contactable address for
# whoever runs this instance. It has no default on purpose — shipping one would
# put someone else's inbox in your push traffic.
VAPID_SUBJECT=

# Optional. Fallback channel for owner-facing events when a push did not land
# (no subscription, push unconfigured, or every endpoint failed).
DISCORD_WEBHOOK_URL=


# ─── Paths ───────────────────────────────────────────────────────────────────

# Path inside the container whose filesystem the storage view measures. Mount
# your library here read-only in compose. If your library spans several
# filesystems, point this at the one that actually fills up.
MEDIA_MOUNT=/media

# SQLite file. Its directory must be a mounted volume or you lose all local
# state on every container recreate. The filename keeps the project's original
# name deliberately: changing the default would silently orphan the database of
# every deploy that upgraded into it.
DB_PATH=/data/pensieve.db

# Built frontend. The image sets this to /app/static already — only override if
# you are running the API without the bundled SPA.
# STATIC_DIR=/app/static


# ─── Proxy trust ─────────────────────────────────────────────────────────────

# Which upstream addresses uvicorn trusts X-Forwarded-For from. The image sets
# "*", which is correct ONLY under the documented deployment: no published
# port, reachable exclusively through your reverse proxy on a private Docker
# network. If that is not true for you, narrow it to the proxy's address —
# the login rate limiter keys on the client IP, and a spoofable header
# defeats it.
# FORWARDED_ALLOW_IPS=172.18.0.0/16


# ─── Branding ────────────────────────────────────────────────────────────────
#
# The frontend reads these at runtime from GET /api/config, so a published
# image can be rebranded without rebuilding it.

# The name shown everywhere: page title, splash, header, footer, PWA manifest
# and Home Screen icon — and the entry this app gets in each of your friends'
# Plex "authorized devices" list.
# APP_NAME=Quorarr

# How member-facing copy names whoever approves things ("Sent to ___ for
# approval", "Awaiting ___"). Every such sentence is pronoun-free, so a name,
# a nickname, or the default role word all read correctly.
# OWNER_NAME=the owner

# Optional subtitle under the wordmark on the login screen — what you call the
# server, as distinct from the app. Empty omits the line entirely.
# Docker reads this file literally, so a value with spaces needs no quotes.
# (If you `source` it into a shell for local development instead, quote it.)
# SERVER_NAME=The Basement Server
